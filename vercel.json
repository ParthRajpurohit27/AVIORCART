{
  "version": 2,
  "outputDirectory": ".",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/dashboard/index.html" },
    { "source": "/collections", "destination": "/collections.html" },
    { "source": "/cart", "destination": "/cart.html" },
    { "source": "/search", "destination": "/search.html" },
    { "source": "/wishlist", "destination": "/wishlist.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/order-success", "destination": "/order-success.html" },
    { "source": "/order-failure", "destination": "/order-failure.html" },
    { "source": "/privacy-policy", "destination": "/privacy-policy.html" },
    { "source": "/terms-and-conditions", "destination": "/terms-and-conditions.html" },
    { "source": "/refund-policy", "destination": "/refund-policy.html" },
    { "source": "/shipping-policy", "destination": "/shipping-policy.html" },
    { "source": "/products/:slug", "destination": "/products/:slug.html" }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/404.html", "status": 404 }
  ]
}
